<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Art/UI/Styles/CommonStyle.uss" />
    <Style src="project://database/Assets/Art/UI/Styles/SettingsPopupStyle.uss" />
    
    <ui:VisualElement name="root" class="fill-parent settings-overlay">
        <ui:VisualElement name="SettingsPopup" class="settings-popup">
            <ui:VisualElement class="settings-header">
                <ui:Label text="SETTINGS" class="settings-title"/>
            </ui:VisualElement>
            <ui:Button name="CloseButton" class="settings-close"/>
            
            <ui:VisualElement class="settings-tabs">
                <ui:Button name="TabSound" text="SOUND" class="settings-tab-button settings-tab-button--active"/>
                <ui:Button name="TabGraphics" text="GRAPHICS" class="settings-tab-button"/>
                <ui:Button name="TabAccount" text="ACCOUNT" class="settings-tab-button"/>
            </ui:VisualElement>
            
            <ui:VisualElement class="settings-content">
                <!-- Sound Panel -->
                <ui:VisualElement name="PanelSound" class="settings-panel">
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Sound Effects" class="settings-label"/>
                        <ui:Toggle name="ToggleSFX"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Background Music" class="settings-label"/>
                        <ui:Toggle name="ToggleMusic"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                
                <!-- Graphics Panel -->
                <ui:VisualElement name="PanelGraphics" class="settings-panel hidden">
                    <ui:VisualElement class="settings-row">
                        <ui:Label text="Show FPS" class="settings-label"/>
                        <ui:Toggle name="ToggleFPS"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                
                <!-- Account Panel -->
                <ui:VisualElement name="PanelAccount" class="settings-panel hidden" style="align-items: center; justify-content: center;">
                    <ui:Label text="Logged in as GUEST" class="settings-label" style="margin-bottom: 50px;"/>
                    <ui:Button name="LogoutButton" text="LOG OUT" class="button-long button-long--yellow"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
