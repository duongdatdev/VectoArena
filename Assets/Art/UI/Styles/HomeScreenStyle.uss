.player-header {
    flex-direction: row-reverse;
    position: absolute;
    left: 80px;
    top: 50px;
    align-items: center;
    scale: 1.2 1.2;
}

.profile-button {
    background-image: url("project://database/Assets/Art/UI/Sprites/Home/background-profile.png");
    width: 164px;
    height: 138px;
    background-color: transparent;
    border-width: 0;
}

.profile-button:active {
    -unity-background-image-tint-color: rgb(200, 200, 200);
}

.player-name {
    position: absolute;
    font-size: 34px;
    left: 164px;
    top: 30px;
    color: rgb(255, 255, 255);
    -unity-font-definition: var(--font-bold);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 4px 4px 0 rgb(0, 0, 0);
}

.top-buttons {
    position: absolute;
    top: 40px;
    right: 40px;
}

.settings-button {
    background-image: url("project://database/Assets/Art/UI/Sprites/Home/icon-settings.png");
    width: 80px;
    height: 80px;
    background-color: transparent;
    border-width: 0;
}

.settings-button:active {
    -unity-background-image-tint-color: rgb(200, 200, 200);
}

.left-buttons {
    position: absolute;
    bottom: 40px;
    left: 40px;
    flex-direction: column;
    justify-content: flex-end;
}

.button-with-icon {
    background-image: url("project://database/Assets/Art/UI/Sprites/Home/button-round.png");
    width: 222px;
    height: 128px;
    background-color: transparent;
    border-width: 0;
    font-size: 34px;
    color: white;
    -unity-font-definition: var(--font-bold);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: black;
    text-shadow: 3px 5px 0 black;
    -unity-text-align: lower-center;
    padding-bottom: 25px;
}

.button-with-icon:active {
    scale: 0.9 0.9;
}

.right-buttons {
    position: absolute;
    bottom: 40px;
    right: 40px;
}

.play-button {
    background-image: url("project://database/Assets/Art/UI/Sprites/Home/button-play.png");
    width: 535px;
    height: 193px;
    background-color: transparent;
    border-width: 0;
    font-size: 74px;
    color: white;
    -unity-font-definition: var(--font-bold);
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: rgb(141, 23, 1);
    text-shadow: 4px 7px 0 rgb(141, 23, 1);
    -unity-text-align: middle-center;
    padding-bottom: 20px;
}

.play-button:active {
    background-image: url("project://database/Assets/Art/UI/Sprites/Home/button-play-pressed.png");
    padding-bottom: 10px;
}

.matchmaking-container {
    background-color: rgba(0, 0, 0, 0.75);
    justify-content: center;
    align-items: center;
}

.matchmaking-status {
    background-image: url("project://database/Assets/Art/UI/Sprites/Home/background-matchmakingstatus.png");
    width: 800px;
    height: 300px;
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
}

.match-timer {
    font-size: 72px;
    color: white;
    -unity-font-definition: var(--font-bold);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: black;
    margin-bottom: -10px;
}

.match-subtitle {
    font-size: 32px;
    color: rgb(240, 209, 94);
    -unity-font-definition: var(--font-bold);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: black;
}
