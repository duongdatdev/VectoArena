.store-background {
    background-color: rgb(15, 10, 30);
}

.store-header {
    height: 100px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(30, 20, 50, 0.8);
    padding-left: 20px;
    padding-right: 20px;
}

.store-title {
    font-size: 48px;
    color: white;
    -unity-font-definition: var(--font-bold);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: black;
    margin-left: 20px;
    flex-grow: 1;
}

.header-currency-row {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
}

.currency-display {
    width: 172px;
    height: 45px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgb(23, 20, 38);
    border-radius: 10px;
    padding-left: 46px;
    padding-right: 14px;
    margin-left: 22px;
    overflow: visible;
}

.currency-display__icon-outline {
    position: absolute;
    left: -24px;
    width: 72px;
    height: 72px;
    align-items: center;
    justify-content: center;
}

.currency-display__icon {
    width: 68px;
    height: 68px;
    -unity-background-scale-mode: scale-to-fit;
}

.currency-display__icon--coin {
    background-image: url("project://database/Assets/Art/UI/Sprites/Currencies/coin-default.png");
}

.currency-display__icon--vec {
    background-image: url("project://database/Assets/Art/UI/Sprites/Currencies/vec-default.png");
}

.currency-label {
    height: 48px;
    font-size: 34px;
    color: white;
    -unity-font-definition: var(--font-bold);
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 3px 5px 0 rgb(0, 0, 0);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.store-status {
    font-size: 30px;
    color: rgb(240, 209, 94);
    -unity-font-definition: var(--font-bold);
    -unity-text-align: middle-center;
    margin-top: 18px;
}

.categories-bar {
    position: absolute;
    bottom: 0;
    width: 100%;
    height: 100px;
    background-color: rgba(50, 41, 90, 0.8);
    flex-direction: row;
    justify-content: center;
}

.category-button {
    font-size: 44px;
    background-color: transparent;
    border-width: 0;
    color: white;
    -unity-font-definition: var(--font-bold);
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: black;
    text-shadow: 5px 5px 0 black;
    margin-left: 20px;
    margin-right: 20px;
    padding-left: 20px;
    padding-right: 20px;
}

.category-button:active {
    color: rgb(240, 209, 94);
}

.product-scroll {
    flex-grow: 1;
    margin-bottom: 100px; /* space for categories */
    padding: 40px;
}

.product-list {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.product-card {
    width: 300px;
    height: 400px;
    background-color: rgba(60, 40, 90, 0.6);
    border-radius: 15px;
    margin: 20px;
    align-items: center;
    padding: 20px;
    border-width: 2px;
    border-color: rgb(100, 70, 150);
}

.product-icon-frame {
    width: 220px;
    height: 220px;
    margin-bottom: 20px;
}

.product-icon {
    width: 220px;
    height: 220px;
    background-color: rgba(0,0,0,0.5);
    border-radius: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.product-price-badge {
    position: absolute;
    right: -6px;
    bottom: 6px;
    min-width: 128px;
    height: 34px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgb(23, 20, 38);
    border-width: 0;
    border-radius: 10px;
    padding-left: 30px;
    padding-right: 10px;
    overflow: visible;
}

.product-price-badge--locked {
    background-color: rgb(37, 24, 43);
}

.product-price-badge--status {
    background-color: rgb(23, 20, 38);
}

.product-price-badge__icon {
    position: absolute;
    left: -13px;
    width: 42px;
    height: 42px;
    -unity-background-scale-mode: scale-to-fit;
}

.product-price-badge--status > .product-price-badge__icon {
    display: none;
}

.product-price-badge__icon--coin {
    background-image: url("project://database/Assets/Art/UI/Sprites/Currencies/coin-default.png");
}

.product-price-badge__icon--vec {
    background-image: url("project://database/Assets/Art/UI/Sprites/Currencies/vec-default.png");
}

.product-price-badge__text {
    height: 36px;
    font-size: 20px;
    color: white;
    -unity-font-definition: var(--font-bold);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(0, 0, 0);
    text-shadow: 2px 3px 0 rgb(0, 0, 0);
    white-space: nowrap;
}

.product-price-badge--locked > .product-price-badge__text {
    color: rgb(255, 190, 196);
}

.product-name {
    font-size: 32px;
    color: white;
    -unity-font-definition: var(--font-bold);
    -unity-text-align: middle-center;
    margin-bottom: auto;
}

.product-price-btn {
    width: 200px;
    height: 60px;
    font-size: 28px;
}
