.death-screen-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(20, 0, 0, 0.85); /* Dark red tint */
}

.death-screen-overlay {
    width: 600px;
    align-items: center;
    padding: 40px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 16px;
    border-width: 2px;
    border-color: rgba(255, 50, 50, 0.3);
}

.death-title {
    font-size: 72px;
    -unity-font-style: bold;
    color: #FF3B30;
    margin-bottom: 20px;
    text-shadow: 0px 4px 10px rgba(255, 0, 0, 0.5);
    letter-spacing: 5px;
}

.death-stats {
    font-size: 24px;
    color: #E0E0E0;
    -unity-text-align: middle-center;
    margin-bottom: 40px;
}

.death-buttons-container {
    flex-direction: row;
    justify-content: center;
}

.death-btn {
    font-size: 20px;
    -unity-font-style: bold;
    padding: 15px 30px;
    border-radius: 8px;
    border-width: 0;
    color: white;
    transition-property: scale, background-color;
    transition-duration: 0.15s;
}

.death-btn:hover {
    scale: 1.05;
}

.death-btn:active {
    scale: 0.95;
}

.primary-btn {
    background-color: #FF9500;
    border-bottom-width: 4px;
    border-bottom-color: #CC7700;
}

.primary-btn:hover {
    background-color: #FFAA33;
}
