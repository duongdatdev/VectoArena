.death-screen-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(20, 0, 0, 0.85);
    display: none;
    flex-direction: column;
}

.death-screen-overlay {
    min-width: 600px;
    align-items: center;
    justify-content: center;
    padding-top: 40px;
    padding-bottom: 40px;
    padding-left: 60px;
    padding-right: 60px;
    background-color: rgba(0, 0, 0, 0.7);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgba(255, 50, 50, 0.4);
    border-right-color: rgba(255, 50, 50, 0.4);
    border-top-color: rgba(255, 50, 50, 0.4);
    border-bottom-color: rgba(255, 50, 50, 0.4);
    display: flex;
    flex-direction: column;
}

.death-title {
    font-size: 72px;
    -unity-font-style: bold;
    color: rgb(255, 59, 48);
    margin-top: 10px;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.death-stats {
    font-size: 32px;
    color: rgb(224, 224, 224);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 50px;
}

.death-buttons-container {
    flex-direction: row;
    justify-content: center;
    margin-top: 20px;
}

.death-btn {
    font-size: 20px;
    -unity-font-style: bold;
    padding-top: 15px;
    padding-bottom: 15px;
    padding-left: 30px;
    padding-right: 30px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: white;
    transition-property: scale, background-color;
    transition-duration: 0.15s;
}

.death-btn:hover {
    scale: 1.05;
}

.death-btn:active {
    scale: 0.95;
}

.primary-btn {
    background-color: rgb(255, 149, 0);
    border-bottom-width: 4px;
    border-bottom-color: rgb(204, 119, 0);
}

.primary-btn:hover {
    background-color: rgb(255, 170, 51);
}
