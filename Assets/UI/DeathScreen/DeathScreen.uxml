<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="DeathScreen.uss" />
    <ui:VisualElement name="DeathScreenContainer" class="death-screen-container">
        <ui:VisualElement class="death-screen-overlay">
            <ui:Label name="DeathTitle" text="YOU DIED" class="death-title" />
            <ui:Label name="DeathStats" text="Killed by: Player1\nWeapon: Rifle" class="death-stats" />
            
            <ui:VisualElement class="death-buttons-container">
                <ui:Button name="ReturnToLobbyBtn" text="RETURN TO LOBBY" class="death-btn primary-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
