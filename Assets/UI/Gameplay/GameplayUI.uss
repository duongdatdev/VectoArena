.kill-feed-container {
    position: absolute;
    left: 56px;
    top: 22px;
    flex-direction: column-reverse;
    align-items: flex-start;
}

.connection-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 8, 18, 0.72);
}

.connection-overlay__panel {
    min-width: 360px;
    padding: 24px 32px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(13, 24, 48, 0.96);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(56, 218, 255);
    border-right-color: rgb(56, 218, 255);
    border-bottom-color: rgb(56, 218, 255);
    border-left-color: rgb(56, 218, 255);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.connection-overlay__spinner {
    width: 18px;
    height: 18px;
    margin-right: 14px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: rgb(56, 218, 255);
    border-right-color: rgba(56, 218, 255, 0.25);
    border-bottom-color: rgba(56, 218, 255, 0.25);
    border-left-color: rgba(56, 218, 255, 0.25);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.connection-overlay__label {
    color: rgb(232, 249, 255);
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}
