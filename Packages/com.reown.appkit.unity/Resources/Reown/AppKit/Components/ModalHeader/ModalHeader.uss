:root {
    width: 100%;
    height: 63px;
    border-bottom-width: 1px;
    border-color: var(--ro-modal-header-border-color);
}

#modal-header__container {
    flex-direction: row;
    justify-content: space-between;
    padding: 16px 18px 16px 18px;
}

#modal-header__body {
    color: var(--ro-color-fg-100);
    padding-left: 12px;
    padding-right: 12px;
}

.modal-header__slot {
    width: 32px;
    height: 32px;
}

#modal-header__snackbar-container-horizontal {
    position: absolute;
    width: 90%;
    height: 100%;
    align-self: center;
    align-items: center;
    flex-direction: column;
}

#modal-header__snackbar-container-vertical {
    height: 100%;
    align-self: center;
    align-items: center;
    justify-content: center;
    flex-direction: row;
}